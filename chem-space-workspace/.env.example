# Chem-Space Workspace Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Chem-Space Workspace"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
# SQLite for development (file-based)
DATABASE_URL=sqlite+aiosqlite:///./chemspace_workspace.db
# PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chemspace_workspace

# LLM Providers (configure at least one for AI agents)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Local/Ollama (for offline development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Chemistry External Services
# PubChem (free, no key required)
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# ChEMBL (free, no key required)
CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data

# NVIDIA BioNeMo NIMs (require NGC API key)
NGC_API_KEY=
BOLTZ2_NIM_URL=https://health.api.nvidia.com/v1/biology/boltz2
DIFFDOCK_NIM_URL=https://health.api.nvidia.com/v1/biology/diffdock
GENMOL_NIM_URL=https://health.api.nvidia.com/v1/biology/genmol
MOLMIM_NIM_URL=https://health.api.nvidia.com/v1/biology/molmim

# Workflow Engine
WORKFLOW_MAX_CONCURRENT_TASKS=4
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=300
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_DELAY_SECONDS=5

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY_HEADER=X-API-Key

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO