# ==============================================================================
# CHEMSPACE CLIENT & BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Custom API Backend Endpoint (optional)
VITE_API_URL=

# Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
SECRET_KEY=generate_a_secure_random_hex_key_here
CORS_ORIGINS=https://che445.com,https://chemistry1-e2723.firebaseapp.com,https://chemistry1-e2723.web.app,http://localhost:5173,http://127.0.0.1:5173

# ChemNova Self-Hosted Chemistry LLM Configuration (Step 1 Foundation)
# Zero external AI API keys needed. The model runs locally on private infrastructure.
MODEL_PATH=chemistry_llm/models/base
DEVICE=auto
MAX_CONTEXT_LENGTH=2048
TEMPERATURE=0.2
TOP_P=0.9
# Google AI Studio / Gemini API Integration (Real-Time Chemistry Copilot)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
VITE_GEMINI_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here

# Real Email Delivery Providers (Configure at least one for live inbox delivery)
# Option A: Resend API (Recommended: simple, high deliverability)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=ChemSpace Security <auth@yourdomain.com>

# Option B: Standard SMTP (Gmail, Outlook, Amazon SES, Brevo, custom mail server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=ChemSpace Security <your-email@gmail.com>
SMTP_SSL=false

# Option C: SendGrid API
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM=auth@yourdomain.com

# Optional Server-Side SMS Provider (Note: Firebase Phone Auth is the primary SMS gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

